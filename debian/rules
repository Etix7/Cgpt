#!/usr/bin/make -f
# Build claude-gpt as a self-contained virtualenv package via dh-virtualenv.
# The Python deps (anthropic, typer, rich, prompt_toolkit) are bundled, so the
# .deb installs on Kali without touching the system Python.

export DH_VIRTUALENV_INSTALL_ROOT=/opt/venvs

%:
	dh $@ --with python-virtualenv

override_dh_virtualenv:
	dh_virtualenv \
	  --builtin-venv \
	  --python /usr/bin/python3 \
	  --preinstall pip \
	  --preinstall wheel \
	  --preinstall setuptools \
	  --preinstall hatchling
